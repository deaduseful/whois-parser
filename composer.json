{
    "name": "deaduseful/whois-parser",
    "description": "A WHOIS record parser that can handle various TLDs and WHOIS server formats",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "DeadUseful",
            "email": "info@deaduseful.com"
        }
    ],
    "require": {
        "php": "^8.0",
        "laravel/framework": "^9.0",
        "nesbot/carbon": "^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "DeadusefulWhoisParser\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DeadusefulWhoisParser\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "DeadusefulWhoisParser\\ServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
