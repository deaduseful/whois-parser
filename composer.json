{
    "name": "deaduseful/whois-parser",
    "description": "A WHOIS record parser that can handle various TLDs and WHOIS server formats",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "DeadUseful",
            "email": "info@deaduseful.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "laravel/framework": "^9.0",
        "nesbot/carbon": "^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5"
    },
    "autoload": {
        "psr-4": {
            "Deaduseful\\WhoisParser\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Deaduseful\\WhoisParser\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Deaduseful\\WhoisParser\\ServiceProvider"
            ]
        }
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true,
        "platform": {
            "php": "8.1"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
